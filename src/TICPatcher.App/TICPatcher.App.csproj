<Project Sdk="Microsoft.NET.Sdk">

  <!-- TIC Patcher, the editor. Windows and Linux (Steam Deck). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TICPatcher</AssemblyName>
    <RootNamespace>TICPatcher.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TICPatcher.Core/TICPatcher.Core.csproj" />
  </ItemGroup>

  <!-- TIC Loader travels inside the editor, which installs or updates it in
       Reloaded-II: built first as a dependency (not linked in), then its files
       are embedded as TICLoader/<name>. -->
  <ItemGroup>
    <ProjectReference Include="../TICLoader/TICLoader.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <Target Name="EmbedTICLoader" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <_TICLoaderFile Include="../TICLoader/bin/$(Configuration)/tic.loader/*" Exclude="../TICLoader/bin/$(Configuration)/tic.loader/*.pdb;../TICLoader/bin/$(Configuration)/tic.loader/watch*" />
      <EmbeddedResource Include="@(_TICLoaderFile)" LogicalName="TICLoader/%(_TICLoaderFile.Filename)%(_TICLoaderFile.Extension)" />
    </ItemGroup>
  </Target>

</Project>
